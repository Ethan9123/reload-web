# Copyrighted art ripped from the Tabletop Simulator mod — most NOT redistributed.
# (The board renders by terrain color; equipment shown as data-driven cards.)
assets/*
# ...except the character figurine standees + reference cards used by the UI (small set).
!assets/characters/
assets/characters/*
!assets/characters/*_2.png
!assets/characters/*_card.png
# but not the misc unnamed single-card decks that also end in _card
assets/characters/deck_*_card.png

# map token art used on the board (small set)
!assets/tokens/
assets/tokens/*
!assets/tokens/Beacon_Fame.png
!assets/tokens/2-Star_Supply.png
!assets/tokens/Toxin.png
!assets/tokens/Dome.png
!assets/tokens/Blue_Hideout.png
!assets/tokens/Green_Hideout.png
!assets/tokens/Purple_Hideout.png
!assets/tokens/Yellow_Hideout.png
# portal tile art + illustrated terrain hex tiles live under hexes/
!assets/hexes/
assets/hexes/*
!assets/hexes/Portal.png
!assets/hexes/tile_*.png

# Editor / OS / runtime
.DS_Store
Thumbs.db
*.log
node_modules/
# debug contact-sheets generated during dev
_*.png
